{
  "name": "@hevn/dapi-sdk",
  "version": "0.1.0",
  "description": "Node.js SDK for the HEVN whitelabel API (/dapi/v1): developer-key sessions, intent verification and co-signing",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hevn-inc/dapi-sdk.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"_tests/**/*.test.ts\"",
    "test:e2e": "node --test --test-concurrency=1 \"_tests/e2e/*.e2e.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.3"
  }
}
